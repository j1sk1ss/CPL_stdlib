glob town __oregon_town_st_helens     = { ref "St. Helens",     14450 };

glob function town::find(ptr i8 name) -> ptr town {
    if not name; return 0 as ptr town;

    if not strcmp(name, __oregon_town_portland.name);      return ref __oregon_town_portland;
    if not strcmp(name, __oregon_town_eugene.name);        return ref __oregon_town_eugene;
    if not strcmp(name, __oregon_town_salem.name);         return ref __oregon_town_salem;
    if not strcmp(name, __oregon_town_gresham.name);       return ref __oregon_town_gresham;
    if not strcmp(name, __oregon_town_hillsboro.name);     return ref __oregon_town_hillsboro;
    if not strcmp(name, __oregon_town_bend.name);          return ref __oregon_town_bend;
    if not strcmp(name, __oregon_town_beaverton.name);     return ref __oregon_town_beaverton;
    if not strcmp(name, __oregon_town_medford.name);       return ref __oregon_town_medford;
    if not strcmp(name, __oregon_town_springfield.name);   return ref __oregon_town_springfield;
    if not strcmp(name, __oregon_town_corvallis.name);     return ref __oregon_town_corvallis;
    if not strcmp(name, __oregon_town_albany.name);        return ref __oregon_town_albany;
    if not strcmp(name, __oregon_town_tigard.name);        return ref __oregon_town_tigard;
    if not strcmp(name, __oregon_town_lake_oswego.name);   return ref __oregon_town_lake_oswego;
    if not strcmp(name, __oregon_town_keizer.name);        return ref __oregon_town_keizer;
    if not strcmp(name, __oregon_town_grants_pass.name);   return ref __oregon_town_grants_pass;
    if not strcmp(name, __oregon_town_oregon_city.name);   return ref __oregon_town_oregon_city;
    if not strcmp(name, __oregon_town_mcminnville.name);   return ref __oregon_town_mcminnville;
    if not strcmp(name, __oregon_town_redmond.name);       return ref __oregon_town_redmond;
    if not strcmp(name, __oregon_town_tualatin.name);      return ref __oregon_town_tualatin;
    if not strcmp(name, __oregon_town_west_linn.name);     return ref __oregon_town_west_linn;
    if not strcmp(name, __oregon_town_wilsonville.name);   return ref __oregon_town_wilsonville;
    if not strcmp(name, __oregon_town_forest_grove.name);  return ref __oregon_town_forest_grove;
    if not strcmp(name, __oregon_town_woodburn.name);      return ref __oregon_town_woodburn;
    if not strcmp(name, __oregon_town_newberg.name);       return ref __oregon_town_newberg;
    if not strcmp(name, __oregon_town_happy_valley.name);  return ref __oregon_town_happy_valley;
    if not strcmp(name, __oregon_town_roseburg.name);      return ref __oregon_town_roseburg;
    if not strcmp(name, __oregon_town_klamath_falls.name); return ref __oregon_town_klamath_falls;
    if not strcmp(name, __oregon_town_ashland.name);       return ref __oregon_town_ashland;
    if not strcmp(name, __oregon_town_milwaukie.name);     return ref __oregon_town_milwaukie;
    if not strcmp(name, __oregon_town_sherwood.name);      return ref __oregon_town_sherwood;
    if not strcmp(name, __oregon_town_hermiston.name);     return ref __oregon_town_hermiston;
    if not strcmp(name, __oregon_town_central_point.name); return ref __oregon_town_central_point;
    if not strcmp(name, __oregon_town_lebanon.name);       return ref __oregon_town_lebanon;
    if not strcmp(name, __oregon_town_canby.name);         return ref __oregon_town_canby;
    if not strcmp(name, __oregon_town_pendleton.name);     return ref __oregon_town_pendleton;
    if not strcmp(name, __oregon_town_dallas.name);        return ref __oregon_town_dallas;
    if not strcmp(name, __oregon_town_troutdale.name);     return ref __oregon_town_troutdale;
    if not strcmp(name, __oregon_town_the_dalles.name);    return ref __oregon_town_the_dalles;
    if not strcmp(name, __oregon_town_coos_bay.name);      return ref __oregon_town_coos_bay;
    if not strcmp(name, __oregon_town_st_helens.name);     return ref __oregon_town_st_helens;

    0 as ptr town
}

glob function town::contains(ptr i8 name) -> bool {
    (town::find(name) != 0 as ptr town) as bool
}

glob function town::count() -> u64 {
    OREGON_TOWN_COUNT as u64
}

@[test] @[abi]
function count_equals_count() -> i0 {
    assert(town::count() != OREGON_TOWN_COUNT, ref "count isn't correct!");
}

@[test] @[abi]
function get_coos_bay() -> i0 {
    ptr town coos_bay = town::find(ref "Coos Bay");
    assert(not coos_bay, ref "Coos Bay isn't found!", 1);
    assert(coos_bay.population != 15686u64, ref "Population is wrong!", 2);
}
