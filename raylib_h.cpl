#define Quaternion           Vector4
#define Texture2D            Texture
#define TextureCubemap       Texture
#define RenderTexture2D      RenderTexture
#define Camera               Camera3D
#define ModelAnimPose        ptr Transform
#define TraceLogCallback     ptr i0
#define LoadFileDataCallback ptr i0
#define SaveFileDataCallback ptr i0
#define LoadFileTextCallback ptr i0
#define SaveFileTextCallback ptr i0
#define AudioCallback        ptr i0

:/ Opaque audio internals. Use only through pointers returned by raylib. /:
@[like_c]
container r_audio_buffer {
    i8 _opaque;
}

@[like_c]
container r_audio_processor {
    i8 _opaque;
}

@[like_c]
container Vector2 {
    f32 x;
    f32 y;
}

@[like_c]
container Vector3 {
    f32 x;
    f32 y;
    f32 z;
}

@[like_c]
container Vector4 {
    f32 x;
    f32 y;
    f32 z;
    f32 w;
}

@[like_c]
container Matrix {
    f32 m0;
    f32 m4;
    f32 m8;
    f32 m12;
    f32 m1;
    f32 m5;
    f32 m9;
    f32 m13;
    f32 m2;
    f32 m6;
    f32 m10;
    f32 m14;
    f32 m3;
    f32 m7;
    f32 m11;
    f32 m15;
}

:/ raylib Color is a 4-byte C value { r, g, b, a }: r | (g << 8) | (b << 16) | (a << 24). /:
#define Color u32

@[like_c]
container Rectangle {
    f32 x;
    f32 y;
    f32 width;
    f32 height;
}

@[like_c]
container Image {
    ptr i0 data;
    i32    width;
    i32    height;
    i32    mipmaps;
    i32    format;
}

@[like_c]
container Texture {
    u32 id;
    i32 width;
    i32 height;
    i32 mipmaps;
    i32 format;
}

@[like_c]
container RenderTexture {
    u32     id;
    Texture texture;
    Texture depth;
}

@[like_c]
container NPatchInfo {
    Rectangle source;
    i32       left;
    i32       top;
    i32       right;
    i32       bottom;
    i32       layout;
}

@[like_c]
container GlyphInfo {
    i32   value;
    i32   offset_x;
    i32   offset_y;
    i32   advance_x;
    Image image;
}

@[like_c]
container Font {
    i32           base_size;
    i32           glyph_count;
    i32           glyph_padding;
    Texture2D     texture;
    ptr Rectangle recs;
    ptr GlyphInfo glyphs;
}

@[like_c]
container Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    f32     fovy;
    i32     projection;
}

@[like_c]
container Camera2D {
    Vector2 offset;
    Vector2 target;
    f32     rotation;
    f32     zoom;
}

@[like_c]
container Mesh {
    i32     vertex_count;
    i32     triangle_count;
    ptr f32 vertices;
    ptr f32 texcoords;
    ptr f32 texcoords2;
    ptr f32 normals;
    ptr f32 tangents;
    ptr u8  colors;
    ptr u16 indices;
    i32     bone_count;
    ptr u8  bone_indices;
    ptr f32 bone_weights;
    ptr f32 anim_vertices;
    ptr f32 anim_normals;
    u32     vao_id;
    ptr u32 vbo_id;
}

@[like_c]
container Shader {
    u32     id;
    ptr i32 locs;
}

@[like_c]
container MaterialMap {
    Texture2D texture;
    Color     color;
    f32       value;
}

@[like_c]
container Material {
    Shader          shader;
    ptr MaterialMap maps;
    arr             params[4, f32];
}

@[like_c]
container Transform {
    Vector3    translation;
    Quaternion rotation;
    Vector3    scale;
}

@[like_c]
container BoneInfo {
    arr name[32, i8];
    i32 parent;
}

@[like_c]
container ModelSkeleton {
    i32           bone_count;
    ptr BoneInfo  bones;
    ModelAnimPose bind_pose;
}

@[like_c]
container Model {
    Matrix        transform;
    i32           mesh_count;
    i32           material_count;
    ptr Mesh      meshes;
    ptr Material  materials;
    ptr i32       mesh_material;
    ModelSkeleton skeleton;
    ModelAnimPose current_pose;
    ptr Matrix    bone_matrices;
}

@[like_c]
container ModelAnimation {
    arr               name[32, i8];
    i32               bone_count;
    i32               keyframe_count;
    ptr ModelAnimPose keyframe_poses;
}

@[like_c]
container Ray {
    Vector3 position;
    Vector3 direction;
}

@[like_c]
container RayCollision {
    bool    hit;
    f32     distance;
    Vector3 point;
    Vector3 normal;
}

@[like_c]
container BoundingBox {
    Vector3 min;
    Vector3 max;
}

@[like_c]
container Wave {
    u32    frame_count;
    u32    sample_rate;
    u32    sample_size;
    u32    channels;
    ptr i0 data;
}

@[like_c]
container AudioStream {
    ptr r_audio_buffer    buffer;
    ptr r_audio_processor processor;
    u32                 sample_rate;
    u32                 sample_size;
    u32                 channels;
}

@[like_c]
container Sound {
    AudioStream stream;
    u32         frame_count;
}

@[like_c]
container Music {
    AudioStream stream;
    u32         frame_count;
    bool        looping;
    i32         ctx_type;
    ptr i0      ctx_data;
}

@[like_c]
container VrDeviceInfo {
    i32 h_resolution;
    i32 v_resolution;
    f32 h_screen_size;
    f32 v_screen_size;
    f32 eye_to_screen_distance;
    f32 lens_separation_distance;
    f32 interpupillary_distance;
    arr lens_distortion_values[4, f32];
    arr chroma_ab_correction[4, f32];
}

@[like_c]
container VrStereoConfig {
    arr projection[2, Matrix];
    arr view_offset[2, Matrix];
    arr left_lens_center[2, f32];
    arr right_lens_center[2, f32];
    arr left_screen_center[2, f32];
    arr right_screen_center[2, f32];
    arr scale[2, f32];
    arr scale_in[2, f32];
}

@[like_c]
container FilePathList {
    u32        count;
    ptr ptr i8 paths;
}

@[like_c]
container AutomationEvent {
    u32 frame;
    u32 type;
    arr params[4, i32];
}

@[like_c]
container AutomationEventList {
    u32                 capacity;
    u32                 count;
    ptr AutomationEvent events;
}

