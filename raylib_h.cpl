:/ Small CPL value constructors for common raylib value types. /:
@[inline(always)]
function ray_color(u8 r, u8 g, u8 b, u8 a) -> Color {
    return (r as u32) | ((g as u32) << 8) | ((b as u32) << 16) | ((a as u32) << 24);
}

@[inline(always)]
function ray_color_r(Color color) -> u8 {
    return (color & 0xFF) as u8;
}

@[inline(always)]
function ray_color_g(Color color) -> u8 {
    return ((color >> 8) & 0xFF) as u8;
}

@[inline(always)]
function ray_color_b(Color color) -> u8 {
    return ((color >> 16) & 0xFF) as u8;
}

@[inline(always)]
function ray_color_a(Color color) -> u8 {
    return ((color >> 24) & 0xFF) as u8;
}

@[inline(always)]
function ray_vector2(f32 x, f32 y) -> Vector2 {
    Vector2 value;
    value.x = x;
    value.y = y;
    return value;
}

@[inline(always)]
function ray_vector3(f32 x, f32 y, f32 z) -> Vector3 {
    Vector3 value;
    value.x = x;
    value.y = y;
    value.z = z;
    return value;
}

@[inline(always)]
function ray_vector4(f32 x, f32 y, f32 z, f32 w) -> Vector4 {
    Vector4 value;
    value.x = x;
    value.y = y;
    value.z = z;
    value.w = w;
    return value;
}

@[inline(always)]
function ray_rectangle(f32 x, f32 y, f32 width, f32 height) -> Rectangle {
    Rectangle value;
    value.x = x;
    value.y = y;
    value.width = width;
    value.height = height;
    return value;
}

