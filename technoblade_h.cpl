#ifndef TECHNO_H_
#define TECHNO_H_

#include "stdio_h.cpl"
#include "stdbool_h.cpl"

container technoblade {
    @[vname("__techno_dies")]
    glob function can_die() -> bool;

    @[vname("__techno_get_summary")] @[inline(always)]
    glob function get_summary() -> ptr i8;

    @[abi]
    @[vname("__techno_hello")]
    glob function hello() -> i0;
}

#endif